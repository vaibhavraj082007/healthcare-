# =============================================================================
# RetinaShield Configuration Template
# Copy to .env and fill in values for your environment
# =============================================================================

# --- General ---
APP_NAME=RetinaShield
APP_ENV=development
# Pipeline version stamp embedded in every analysis result
PIPELINE_VERSION=0.1.0-dev
DEBUG=true
LOG_LEVEL=INFO

# --- FastAPI Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Secret key for JWT / session signing (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retinashield
POSTGRES_USER=retinashield
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Image Storage ---
# Private storage for fundus images (never served directly to the web)
IMAGE_STORAGE_PATH=./data/images
# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=50

# --- MATLAB Integration ---
# Mode: "engine" (requires full MATLAB), "mcr" (compiled runtime), "fallback" (Python-only)
MATLAB_MODE=fallback
# Path to MATLAB installation (required for engine mode)
MATLAB_ROOT=
# Path to MATLAB Runtime (required for mcr mode)
MCR_ROOT=
# Path to compiled MATLAB package (required for mcr mode)
MATLAB_COMPILED_PACKAGE=

# --- YOLOv8 Lesion Detection ---
# Path to trained YOLOv8 weights file (.pt)
YOLO_WEIGHTS_PATH=
# Confidence threshold for lesion detection
YOLO_CONFIDENCE_THRESHOLD=0.25
# Device for YOLOv8 inference: "cpu", "mps" (Apple Silicon), "cuda:0"
YOLO_DEVICE=mps

# --- EfficientNet-B0 (MATLAB) ---
# Path to trained EfficientNet-B0 weights (.mat file)
EFFICIENTNET_WEIGHTS_PATH=
# Input image size for EfficientNet-B0
EFFICIENTNET_INPUT_SIZE=224

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=RetinaShield

# --- Facility / Offline Mode ---
FACILITY_ID=dev-facility-001
FACILITY_NAME=Development Facility
# SQLite database for offline queue
FACILITY_QUEUE_DB=./data/facility_queue.db
# Central server URL for sync (when online)
SYNC_SERVER_URL=http://localhost:8000
# Sync interval in seconds
SYNC_INTERVAL_SECONDS=300
# Enable offline mode
OFFLINE_MODE=false

# --- Security ---
# Encryption key for stored images (Fernet key, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
IMAGE_ENCRYPTION_KEY=
# Enable/disable image encryption
ENCRYPT_IMAGES=false
