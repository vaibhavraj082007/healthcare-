{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RetinaShield Analysis Result",
  "description": "Research screening result — NOT an autonomous clinical diagnosis. Must be reviewed by a qualified ophthalmologist.",
  "type": "object",
  "required": ["analysis_id", "image_id", "pipeline_version", "timestamp", "disclaimer"],
  "properties": {
    "analysis_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this analysis run"
    },
    "image_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the uploaded fundus image"
    },
    "patient_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the patient record"
    },
    "facility_id": {
      "type": "string",
      "description": "Identifier for the healthcare facility"
    },
    "pipeline_version": {
      "type": "string",
      "description": "Semantic version of the analysis pipeline (e.g., 0.1.0-dev)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of analysis completion"
    },
    "disclaimer": {
      "type": "string",
      "const": "RESEARCH SCREENING RESULT — Not a clinical diagnosis. Must be reviewed by a qualified ophthalmologist."
    },
    "quality_assessment": {
      "type": "object",
      "description": "Image quality metrics from MATLAB IQA module",
      "properties": {
        "overall_quality": {
          "type": "string",
          "enum": ["good", "acceptable", "poor", "rejected"],
          "description": "Composite quality verdict"
        },
        "brisque_score": {
          "type": "number",
          "description": "Blind/Referenceless Image Spatial Quality Evaluator score (lower = better)"
        },
        "sharpness_score": {
          "type": "number",
          "description": "Laplacian variance-based sharpness metric"
        },
        "illumination_uniformity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Uniformity of illumination across the fundus (1 = perfectly uniform)"
        },
        "field_of_view_adequate": {
          "type": "boolean",
          "description": "Whether the image captures sufficient retinal area"
        },
        "artifacts_detected": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of detected artifacts (e.g., 'dust', 'reflection', 'motion_blur')"
        }
      },
      "required": ["overall_quality"]
    },
    "enhancement": {
      "type": "object",
      "description": "Enhancement outputs from MATLAB preprocessing",
      "properties": {
        "method": {
          "type": "string",
          "description": "Enhancement method applied (e.g., 'CLAHE_green_channel')"
        },
        "enhanced_image_path": {
          "type": "string",
          "description": "Path to the enhanced fundus image"
        },
        "green_channel_path": {
          "type": "string",
          "description": "Path to the extracted green channel image"
        }
      }
    },
    "structure_analysis": {
      "type": "object",
      "description": "Retinal structure segmentation and localization from MATLAB",
      "properties": {
        "is_experimental": {
          "type": "boolean",
          "default": true,
          "description": "Labelled experimental until validated against expert ground truth"
        },
        "field_of_view": {
          "type": "object",
          "properties": {
            "mask_path": { "type": "string" },
            "bounding_box": { "type": "array", "items": { "type": "number" } },
            "center_x": { "type": "number" },
            "center_y": { "type": "number" },
            "radius": { "type": "number" },
            "area_pixels": { "type": "number" },
            "area_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "is_reliable": { "type": "boolean" },
            "failure_reason": { "type": "string" },
            "algorithm_version": { "type": "string" }
          }
        },
        "optic_disc": {
          "type": "object",
          "properties": {
            "detected": { "type": "boolean" },
            "center_x": { "type": ["number", "null"] },
            "center_y": { "type": ["number", "null"] },
            "radius": { "type": ["number", "null"] },
            "mask_path": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "is_reliable": { "type": "boolean" },
            "failure_reason": { "type": "string" },
            "algorithm_version": { "type": "string" }
          },
          "required": ["detected"]
        },
        "macula": {
          "type": "object",
          "properties": {
            "detected": { "type": "boolean" },
            "center_x": { "type": ["number", "null"] },
            "center_y": { "type": ["number", "null"] },
            "radius": { "type": ["number", "null"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "is_reliable": { "type": "boolean" },
            "failure_reason": { "type": "string" },
            "inferred_laterality": { "type": "string", "enum": ["OD", "OS", "unknown"] },
            "algorithm_version": { "type": "string" }
          },
          "required": ["detected"]
        },
        "fovea": {
          "type": "object",
          "properties": {
            "detected": { "type": "boolean" },
            "center_x": { "type": ["number", "null"] },
            "center_y": { "type": ["number", "null"] },
            "radius": { "type": ["number", "null"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "is_reliable": { "type": "boolean" },
            "failure_reason": { "type": "string" },
            "inferred_laterality": { "type": "string", "enum": ["OD", "OS", "unknown"] },
            "algorithm_version": { "type": "string" }
          }
        },
        "vasculature": {
          "type": "object",
          "properties": {
            "segmentation_mask_path": { "type": "string" },
            "vessel_density": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Ratio of vessel pixels to total retinal area"
            },
            "tortuosity_index": {
              "type": "number",
              "description": "Mean vessel tortuosity (arc-chord ratio)"
            },
            "caliber_proxy": { "type": "number" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "is_reliable": { "type": "boolean" },
            "failure_reason": { "type": "string" },
            "algorithm_version": { "type": "string" }
          }
        }
      }
    },
    "severity_classification": {
      "type": "object",
      "description": "DR severity from MATLAB EfficientNet-B0",
      "properties": {
        "model": { "type": "string", "default": "EfficientNet-B0" },
        "predicted_grade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "DR severity grade: 0=No DR, 1=Mild, 2=Moderate, 3=Severe, 4=Proliferative"
        },
        "grade_label": {
          "type": "string",
          "enum": ["No DR", "Mild NPDR", "Moderate NPDR", "Severe NPDR", "Proliferative DR"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence of the predicted grade"
        },
        "class_probabilities": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 5,
          "maxItems": 5,
          "description": "Softmax probabilities for each of the 5 DR grades"
        },
        "gradcam_heatmap_path": {
          "type": "string",
          "description": "Path to the Grad-CAM explainability heatmap image"
        },
        "model_trained": {
          "type": "boolean",
          "default": false,
          "description": "Whether the model has been trained on real data (false = placeholder/untrained)"
        }
      },
      "required": ["model", "model_trained"]
    },
    "lesion_detection": {
      "type": "object",
      "description": "YOLOv8-based lesion detection with tiling adapter and candidate tracking",
      "properties": {
        "model": { "type": "string", "default": "YOLOv8" },
        "status": {
          "type": "string",
          "enum": ["ready", "unavailable", "heuristic_only"],
          "default": "unavailable"
        },
        "message": { "type": "string" },
        "model_estimated_count": {
          "type": "object",
          "description": "Estimated count of lesions per type"
        },
        "detections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lesion_type": {
                "type": "string",
                "enum": ["microaneurysm", "hemorrhage", "hard_exudate", "soft_exudate", "neovascularization", "cotton_wool_spot"]
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x_min": { "type": "number" },
                  "y_min": { "type": "number" },
                  "x_max": { "type": "number" },
                  "y_max": { "type": "number" }
                },
                "required": ["x_min", "y_min", "x_max", "y_max"]
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "approximate_extent": {
                "type": "object",
                "properties": {
                  "area_pixels": { "type": "number" },
                  "equivalent_diameter": { "type": "number" },
                  "width": { "type": "number" },
                  "height": { "type": "number" }
                }
              },
              "is_heuristic_candidate": { "type": "boolean", "default": false }
            },
            "required": ["lesion_type", "bbox", "confidence"]
          }
        },
        "model_trained": {
          "type": "boolean",
          "default": false,
          "description": "Whether the YOLOv8 model has been trained on real lesion data"
        }
      },
      "required": ["model", "model_trained"]
    },
    "gradcam_explanation": {
      "type": "object",
      "description": "Grad-CAM explainability heatmap from actual model activations",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "unavailable", "error"]
        },
        "reason": {
          "type": "string"
        },
        "gradcam_heatmap_path": {
          "type": ["string", "null"]
        },
        "gradcam_overlay_path": {
          "type": ["string", "null"]
        },
        "gradcam_raw_path": {
          "type": ["string", "null"]
        },
        "target_layer": {
          "type": ["string", "null"]
        },
        "target_class": {
          "type": ["string", "null"]
        },
        "predicted_class": {
          "type": ["string", "null"]
        },
        "preprocessing_transform": {
          "type": ["object", "null"]
        },
        "algorithm_version": {
          "type": "string"
        },
        "disclaimer": {
          "type": "string"
        },
        "pointing_game_hit": {
          "type": ["boolean", "null"]
        },
        "expert_iou": {
          "type": ["number", "null"]
        },
        "energy_pointing_game": {
          "type": ["number", "null"]
        }
      },
      "required": ["status", "algorithm_version", "disclaimer"]
    },
    "confidence_calibration": {
      "type": "object",
      "description": "Post-hoc confidence calibration parameters and predictive uncertainty metrics",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["calibrated", "uncalibrated_raw_softmax", "fallback_uniform"],
          "description": "Calibration status"
        },
        "temperature": {
          "type": ["number", "null"],
          "description": "Temperature scaling factor T optimized on designated calibration data"
        },
        "max_calibrated_probability": {
          "type": ["number", "null"],
          "description": "Maximum calibrated probability for top class"
        },
        "confidence_margin": {
          "type": ["number", "null"],
          "description": "Margin between top 1 and top 2 class probabilities"
        },
        "shannon_entropy": {
          "type": ["number", "null"],
          "description": "Normalized Shannon entropy in [0, 1] representing predictive uncertainty"
        },
        "is_uncertain": {
          "type": "boolean",
          "description": "True if confidence is below threshold or entropy is high"
        }
      },
      "required": ["status", "is_uncertain"]
    },
    "consistency_analysis": {
      "type": "object",
      "description": "Conservative dual-engine consistency evaluation between DR classifier, lesions, and IQA",
      "properties": {
        "consistency_status": {
          "type": "string",
          "enum": [
            "concordant",
            "discordant_classifier_high",
            "discordant_lesions_high",
            "uncertain_prediction",
            "quality_compromised",
            "component_unavailable"
          ],
          "description": "Overall consistency verdict between classification and lesion findings"
        },
        "finding_label": {
          "type": "string",
          "description": "Clinical finding label (e.g. 'Concordant AI findings', strictly never 'Confirmed diagnosis')"
        },
        "human_review_required": {
          "type": "boolean",
          "description": "Whether this case requires mandatory human review"
        },
        "review_reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of explicit clinical triggers for review"
        },
        "recommended_grade": {
          "type": ["integer", "null"],
          "description": "Safest conservative recommended grade"
        },
        "recommended_urgency": {
          "type": "string",
          "enum": ["none", "routine", "priority", "urgent"],
          "description": "Conservative referral urgency"
        },
        "rules_version": {
          "type": "string",
          "description": "Version identifier of the consistency rules"
        }
      },
      "required": ["consistency_status", "finding_label", "human_review_required", "review_reasons", "rules_version"]
    },
    "referral_recommendation": {
      "type": "object",
      "description": "Rule-based referral suggestion derived from severity + lesion findings",
      "properties": {
        "urgency": {
          "type": "string",
          "enum": ["none", "routine", "priority", "urgent"],
          "description": "none=No DR, routine=Mild, priority=Moderate/Severe, urgent=PDR or macular involvement"
        },
        "reason": {
          "type": "string",
          "description": "Human-readable explanation of the referral recommendation"
        },
        "suggested_followup_weeks": {
          "type": "integer",
          "minimum": 0,
          "description": "Suggested follow-up interval in weeks"
        }
      },
      "required": ["urgency", "reason"]
    }
  }
}
